{
  "name": "whatsapp-ai-assistant",
  "version": "1.0.0",
  "description": "Personal WhatsApp AI assistant with away-mode auto-reply and task extraction",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "register": "node index.js register",
    "list-sessions": "node index.js list",
    "dev": "nodemon --ignore sessions index.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart whatsapp-assistant",
    "pm2:logs": "pm2 logs whatsapp-assistant",
    "pm2:stop": "pm2 stop whatsapp-assistant"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "dotenv": "^16.4.5",
    "link-preview-js": "^3.2.0",
    "pino": "^9.4.0",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "@whiskeysockets/baileys@7.0.0-rc14": true,
    "protobufjs@7.6.5": true
  }
}
