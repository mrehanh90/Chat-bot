# --- Google Gemini ---

GEMINI_MODEL=gemini-2.5-flash

# --- Bot behavior ---
# Your own WhatsApp JID (country code + number, no leading 0, no +).
# 03392554286 -> 923392554286@s.whatsapp.net
BOT_OWNER_NUMBER=923392554286@s.whatsapp.net

# Ignore group chats entirely (recommended: true)
IGNORE_GROUPS=true

# Max characters of incoming message text sent to Gemini (cost/abuse guard)
MAX_INPUT_CHARS=2000

# Minimum ms between two AI replies to the SAME chat (basic flood guard)
MIN_REPLY_INTERVAL_MS=15000
