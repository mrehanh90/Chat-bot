# --- OpenRouter ---
# Create an API key in the OpenRouter dashboard.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Free structured-output model. You can change this to another OpenRouter model.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Model used for questions that require current/live web information.
# A funded OpenRouter account is required for dependable web-grounded answers.
OPENROUTER_LIVE_MODEL=openrouter/auto

# Optional comma-separated backup models attempted after a retryable API failure.
OPENROUTER_FALLBACK_MODELS=

# API reliability controls.
OPENROUTER_REQUEST_TIMEOUT_MS=30000
OPENROUTER_MAX_RETRIES=2

# Web search is charged separately by OpenRouter. "exa" is a model-agnostic default.
OPENROUTER_WEB_SEARCH_ENGINE=exa

# Used to transcribe WhatsApp voice notes before the normal assistant flow.
# Confirm pricing/availability in OpenRouter before using this model.
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Optional attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=WhatsApp AI Assistant

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Optional: set an HTTPS callback URL exposed by a reverse proxy/tunnel. This
# lets the Google approval link complete on a mobile phone. Leave blank for the
# local computer-only callback at http://127.0.0.1:3000/oauth2callback.
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_PORT=3000
# Keep 127.0.0.1 when a reverse proxy/tunnel forwards requests locally.
GOOGLE_CALENDAR_CALLBACK_HOST=127.0.0.1
GOOGLE_CALENDAR_REMINDER_MINUTES=30
# Optional dedicated key used to encrypt saved Google refresh tokens. If blank,
# the OpenRouter API key is used as the local encryption secret.
CALENDAR_TOKEN_ENCRYPTION_KEY=

# --- Bot behavior (applies to every user session) ---
APP_TIME_ZONE=Asia/Karachi

# Ignore group chats entirely (recommended: true)
IGNORE_GROUPS=true

# Max characters of incoming message text sent to OpenRouter (cost/abuse guard)
MAX_INPUT_CHARS=2000

# Minimum ms between two AI replies to the SAME chat (basic flood guard)
MIN_REPLY_INTERVAL_MS=15000

# --- Local dashboard administrator ---
# Change both values before exposing the dashboard to anyone else.
DASHBOARD_ADMIN_USERNAME=admin
DASHBOARD_ADMIN_PASSWORD=admin
