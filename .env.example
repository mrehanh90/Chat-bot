# --- OpenRouter ---
# Create an API key in the OpenRouter dashboard.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Free structured-output model. You can change this to another OpenRouter model.
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Model used for questions that require current/live web information.
# This can be the same free model; web search itself may incur OpenRouter search charges.
OPENROUTER_LIVE_MODEL=openai/gpt-oss-20b:free

# Optional attribution headers.
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=WhatsApp AI Assistant

# --- Bot behavior ---
# Your own WhatsApp JID (country code + number, no leading 0, no +).
# 03001234567 -> 923001234567@s.whatsapp.net
BOT_OWNER_NUMBER=923001234567@s.whatsapp.net

# Ignore group chats entirely (recommended: true)
IGNORE_GROUPS=true

# Max characters of incoming message text sent to OpenRouter (cost/abuse guard)
MAX_INPUT_CHARS=2000

# Minimum ms between two AI replies to the SAME chat (basic flood guard)
MIN_REPLY_INTERVAL_MS=15000
